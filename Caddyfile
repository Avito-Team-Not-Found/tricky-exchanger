menyayka.tech, www.menyayka.tech {
	encode gzip

	# Liveness бэкенда (не отдавать SPA с frontend)
	handle /healthz {
		reverse_proxy backend:8080
	}

	# Фото товаров из MinIO: https://menyayka.tech/s3/items/...
	handle_path /s3/* {
		reverse_proxy minio:9000
	}

	# API same-origin для фронта с пустым VITE_API_BASE_URL
	handle /api/* {
		reverse_proxy backend:8080
	}

	handle {
		reverse_proxy frontend:80
	}
}
