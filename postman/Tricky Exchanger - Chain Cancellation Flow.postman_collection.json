{
  "info": {
    "name": "Tricky Exchanger - Chain Cancellation Flow",
    "description": "Папка 00 создаёт общую исходную цепочку. Перед каждой отдельной папкой 01-03 запустите 00 заново; каждая целевая папка сама доводит исходную цепочку до требуемого состояния.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080" },
    { "key": "test_password", "value": "TestPass123!" },
    { "key": "run_id", "value": "" },
    { "key": "chain_id", "value": "" },
    { "key": "replacement_request_id", "value": "" },
    { "key": "replacement_token", "value": "" },
    { "key": "expired_chain_id", "value": "" },
    { "key": "expired_participant_token", "value": "" }
  ],
  "item": [
    {
      "name": "00 - Подготовить цепочку и первичные отклики",
      "description": "Создаёт A-B-C и две альтернативы D/E в кластере B. В конце цепочка PROPOSED, подтверждён только A.",
      "item": [
        {
          "name": "Register A",
          "event": [{ "listen": "prerequest", "script": { "exec": ["pm.collectionVariables.set('run_id', Date.now());"] } }, { "listen": "test", "script": { "exec": ["pm.test('A registered', () => pm.expect(pm.response.code).to.be.oneOf([200,201]));", "pm.collectionVariables.set('token_a', pm.response.json().token);"] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"fullName\":\"Participant A\",\"email\":\"cancel-{{run_id}}-a@example.test\",\"password\":\"{{test_password}}\"}" }, "url": "{{base_url}}/api/v1/auth/register" }
        },
        {
          "name": "Register B",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('B registered', () => pm.expect(pm.response.code).to.be.oneOf([200,201]));", "pm.collectionVariables.set('token_b', pm.response.json().token);"] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"fullName\":\"Participant B\",\"email\":\"cancel-{{run_id}}-b@example.test\",\"password\":\"{{test_password}}\"}" }, "url": "{{base_url}}/api/v1/auth/register" }
        },
        {
          "name": "Register C",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('C registered', () => pm.expect(pm.response.code).to.be.oneOf([200,201]));", "pm.collectionVariables.set('token_c', pm.response.json().token);"] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"fullName\":\"Participant C\",\"email\":\"cancel-{{run_id}}-c@example.test\",\"password\":\"{{test_password}}\"}" }, "url": "{{base_url}}/api/v1/auth/register" }
        },
        {
          "name": "Register replacement D",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('D registered', () => pm.expect(pm.response.code).to.be.oneOf([200,201]));", "pm.collectionVariables.set('token_d', pm.response.json().token);"] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"fullName\":\"Replacement D\",\"email\":\"cancel-{{run_id}}-d@example.test\",\"password\":\"{{test_password}}\"}" }, "url": "{{base_url}}/api/v1/auth/register" }
        },
        {
          "name": "Register replacement E",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('E registered', () => pm.expect(pm.response.code).to.be.oneOf([200,201]));", "pm.collectionVariables.set('token_e', pm.response.json().token);"] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"fullName\":\"Replacement E\",\"email\":\"cancel-{{run_id}}-e@example.test\",\"password\":\"{{test_password}}\"}" }, "url": "{{base_url}}/api/v1/auth/register" }
        },
        {
          "name": "A creates Nintendo Switch",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('A item created', () => pm.expect(pm.response.code).to.be.oneOf([200,201]));", "pm.collectionVariables.set('item_a', pm.response.json().id);"] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token_a}}" }], "body": { "mode": "raw", "raw": "{\"title\":\"Nintendo Switch OLED\",\"description\":\"Игровая консоль Nintendo Switch OLED в отличном состоянии.\",\"category\":\"Игры и приставки\"}" }, "url": "{{base_url}}/api/v1/items" }
        },
        {
          "name": "B creates iPad",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('B item created', () => pm.expect(pm.response.code).to.be.oneOf([200,201]));", "pm.collectionVariables.set('item_b', pm.response.json().id);"] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token_b}}" }], "body": { "mode": "raw", "raw": "{\"title\":\"Apple iPad Air 5\",\"description\":\"Планшет Apple iPad Air пятого поколения, бережное использование.\",\"category\":\"Планшеты и электронные книги\"}" }, "url": "{{base_url}}/api/v1/items" }
        },
        {
          "name": "C creates Kindle",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('C item created', () => pm.expect(pm.response.code).to.be.oneOf([200,201]));", "pm.collectionVariables.set('item_c', pm.response.json().id);"] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token_c}}" }], "body": { "mode": "raw", "raw": "{\"title\":\"Amazon Kindle Paperwhite\",\"description\":\"Электронная книга Kindle Paperwhite с подсветкой.\",\"category\":\"Книги и журналы\"}" }, "url": "{{base_url}}/api/v1/items" }
        },
        {
          "name": "D creates replacement iPad",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('D item created', () => pm.expect(pm.response.code).to.be.oneOf([200,201]));", "pm.collectionVariables.set('item_d', pm.response.json().id);"] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token_d}}" }], "body": { "mode": "raw", "raw": "{\"title\":\"Apple iPad Air 5\",\"description\":\"Планшет Apple iPad Air пятого поколения, бережное использование.\",\"category\":\"Планшеты и электронные книги\"}" }, "url": "{{base_url}}/api/v1/items" }
        },
        {
          "name": "E creates replacement iPad",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('E item created', () => pm.expect(pm.response.code).to.be.oneOf([200,201]));", "pm.collectionVariables.set('item_e', pm.response.json().id);"] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token_e}}" }], "body": { "mode": "raw", "raw": "{\"title\":\"Apple iPad Air 5\",\"description\":\"Планшет Apple iPad Air пятого поколения, бережное использование.\",\"category\":\"Планшеты и электронные книги\"}" }, "url": "{{base_url}}/api/v1/items" }
        },
        {
          "name": "A creates Switch for iPad offer",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('A offer created', () => pm.expect(pm.response.code).to.be.oneOf([200,201]));", "pm.collectionVariables.set('offer_a', pm.response.json().id);"] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token_a}}" }], "body": { "mode": "raw", "raw": "{\"offeredItemId\":{{item_a}},\"wantedDescription\":\"Apple iPad Air 5\",\"wantedCategory\":\"Планшеты и электронные книги\"}" }, "url": "{{base_url}}/api/v1/exchange-offers" }
        },
        {
          "name": "B creates iPad for Kindle offer",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('B offer created', () => pm.expect(pm.response.code).to.be.oneOf([200,201]));", "pm.collectionVariables.set('offer_b', pm.response.json().id);"] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token_b}}" }], "body": { "mode": "raw", "raw": "{\"offeredItemId\":{{item_b}},\"wantedDescription\":\"Amazon Kindle Paperwhite\",\"wantedCategory\":\"Книги и журналы\"}" }, "url": "{{base_url}}/api/v1/exchange-offers" }
        },
        {
          "name": "C creates Kindle for Switch offer",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('C offer created', () => pm.expect(pm.response.code).to.be.oneOf([200,201]));", "pm.collectionVariables.set('offer_c', pm.response.json().id);"] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token_c}}" }], "body": { "mode": "raw", "raw": "{\"offeredItemId\":{{item_c}},\"wantedDescription\":\"Nintendo Switch OLED\",\"wantedCategory\":\"Игры и приставки\"}" }, "url": "{{base_url}}/api/v1/exchange-offers" }
        },
        {
          "name": "D creates alternative iPad offer",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('D offer created', () => pm.expect(pm.response.code).to.be.oneOf([200,201]));", "pm.collectionVariables.set('offer_d', pm.response.json().id);"] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token_d}}" }], "body": { "mode": "raw", "raw": "{\"offeredItemId\":{{item_d}},\"wantedDescription\":\"Amazon Kindle Paperwhite\",\"wantedCategory\":\"Книги и журналы\"}" }, "url": "{{base_url}}/api/v1/exchange-offers" }
        },
        {
          "name": "E creates alternative iPad offer",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('E offer created', () => pm.expect(pm.response.code).to.be.oneOf([200,201]));", "pm.collectionVariables.set('offer_e', pm.response.json().id);"] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token_e}}" }], "body": { "mode": "raw", "raw": "{\"offeredItemId\":{{item_e}},\"wantedDescription\":\"Amazon Kindle Paperwhite\",\"wantedCategory\":\"Книги и журналы\"}" }, "url": "{{base_url}}/api/v1/exchange-offers" }
        },
        {
          "name": "Find exact A-B-C candidate",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Chains loaded', () => pm.response.to.have.status(200));", "const ids=['offer_a','offer_b','offer_c'].map(k=>Number(pm.collectionVariables.get(k)));", "const chain=pm.response.json().find(c=>c.status==='CANDIDATE'&&ids.every(id=>c.participants.some(p=>Number(p.requestId)===id)));", "pm.test('Exact A-B-C chain found',()=>pm.expect(chain).to.exist);", "if(chain) pm.collectionVariables.set('chain_id',chain.id);"] } }],
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token_a}}" }], "url": "{{base_url}}/api/v1/chains" }
        },
        { "name": "A primary response to B", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token_a}}" }], "body": { "mode": "raw", "raw": "{\"requestId\":{{offer_a}},\"targetRequestId\":{{offer_b}}}" }, "url": "{{base_url}}/api/v1/chains/{{chain_id}}/votes" } },
        { "name": "B primary response to C", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token_b}}" }], "body": { "mode": "raw", "raw": "{\"requestId\":{{offer_b}},\"targetRequestId\":{{offer_c}}}" }, "url": "{{base_url}}/api/v1/chains/{{chain_id}}/votes" } },
        {
          "name": "C primary response to A",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Proposal assembled',()=>pm.expect(pm.response.json().chainStatus).to.eql('PROPOSED'));"] } }],
          "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token_c}}" }], "body": { "mode": "raw", "raw": "{\"requestId\":{{offer_c}},\"targetRequestId\":{{offer_a}}}" }, "url": "{{base_url}}/api/v1/chains/{{chain_id}}/votes" }
        },
        {
          "name": "A confirms",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('A confirmed, chain still PROPOSED',()=>pm.expect(pm.response.json().status).to.eql('PROPOSED'));"] } }],
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token_a}}" }], "url": "{{base_url}}/api/v1/chains/{{chain_id}}/confirm" }
        }
      ]
    },
    {
      "name": "01 - Отозвать подтверждение и заморозить",
      "item": [
        {
          "name": "A unconfirms",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Vote returned to pending',()=>{pm.response.to.have.status(200);pm.expect(pm.response.json().vote).to.eql('pending');});"] } }],
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token_a}}" }], "url": "{{base_url}}/api/v1/chains/{{chain_id}}/unconfirm" }
        },
        { "name": "A confirms again", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token_a}}" }], "url": "{{base_url}}/api/v1/chains/{{chain_id}}/confirm" } },
        { "name": "B confirms", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token_b}}" }], "url": "{{base_url}}/api/v1/chains/{{chain_id}}/confirm" } },
        {
          "name": "C confirms and freezes chain",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Chain is FROZEN',()=>{pm.response.to.have.status(200);pm.expect(pm.response.json().status).to.eql('FROZEN');});"] } }],
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token_c}}" }], "url": "{{base_url}}/api/v1/chains/{{chain_id}}/confirm" }
        }
      ]
    },
    {
      "name": "02 - Успешная замена после FROZEN",
      "item": [
        { "name": "B confirms base proposal", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token_b}}" }], "url": "{{base_url}}/api/v1/chains/{{chain_id}}/confirm" } },
        {
          "name": "C confirms and freezes base chain",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Base chain is FROZEN',()=>{pm.response.to.have.status(200);pm.expect(pm.response.json().status).to.eql('FROZEN');});"] } }],
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token_c}}" }], "url": "{{base_url}}/api/v1/chains/{{chain_id}}/confirm" }
        },
        {
          "name": "B declines frozen chain",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Replacement round opened',()=>{pm.response.to.have.status(200);const b=pm.response.json();pm.expect(b.status).to.eql('PROPOSED');pm.expect(b.replacementAvailable).to.eql(true);});"] } }],
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token_b}}" }], "url": "{{base_url}}/api/v1/chains/{{chain_id}}/decline" }
        },
        {
          "name": "A gets D and E replacements",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Replacement options loaded',()=>pm.response.to.have.status(200));", "const options=pm.response.json();const expected=[Number(pm.collectionVariables.get('offer_d')),Number(pm.collectionVariables.get('offer_e'))];", "pm.test('D and E offered',()=>expected.forEach(id=>pm.expect(options.some(x=>Number(x.requestId)===id)).to.eql(true)));", "const chosen=options.find(x=>expected.includes(Number(x.requestId)));if(chosen){pm.collectionVariables.set('replacement_request_id',chosen.requestId);const isD=Number(chosen.requestId)===Number(pm.collectionVariables.get('offer_d'));pm.collectionVariables.set('replacement_token',pm.collectionVariables.get(isD?'token_d':'token_e'));}"] } }],
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token_a}}" }], "url": "{{base_url}}/api/v1/chains/{{chain_id}}/replacements" }
        },
        { "name": "A selects replacement", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token_a}}" }], "body": { "mode": "raw", "raw": "{\"requestId\":{{replacement_request_id}}}" }, "url": "{{base_url}}/api/v1/chains/{{chain_id}}/replacement" } },
        { "name": "A reconfirms changed edge", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token_a}}" }], "url": "{{base_url}}/api/v1/chains/{{chain_id}}/confirm" } },
        {
          "name": "Replacement confirms and freezes again",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Chain frozen with replacement',()=>{pm.response.to.have.status(200);pm.expect(pm.response.json().status).to.eql('FROZEN');});"] } }],
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{replacement_token}}" }], "url": "{{base_url}}/api/v1/chains/{{chain_id}}/confirm" }
        }
      ]
    },
    {
      "name": "03 - Второй отказ завершает замену откатом",
      "item": [
        { "name": "B confirms base proposal", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token_b}}" }], "url": "{{base_url}}/api/v1/chains/{{chain_id}}/confirm" } },
        {
          "name": "C confirms and freezes base chain",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Base chain is FROZEN',()=>{pm.response.to.have.status(200);pm.expect(pm.response.json().status).to.eql('FROZEN');});"] } }],
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token_c}}" }], "url": "{{base_url}}/api/v1/chains/{{chain_id}}/confirm" }
        },
        {
          "name": "B opens first replacement round",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('First replacement available',()=>{pm.response.to.have.status(200);pm.expect(pm.response.json().replacementAvailable).to.eql(true);});"] } }],
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token_b}}" }], "url": "{{base_url}}/api/v1/chains/{{chain_id}}/decline" }
        },
        {
          "name": "A chooses first replacement option",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Options loaded',()=>pm.response.to.have.status(200));", "const options=pm.response.json();const expected=[Number(pm.collectionVariables.get('offer_d')),Number(pm.collectionVariables.get('offer_e'))];const chosen=options.find(x=>expected.includes(Number(x.requestId)));", "pm.test('A replacement exists',()=>pm.expect(chosen).to.exist);", "if(chosen){pm.collectionVariables.set('replacement_request_id',chosen.requestId);const isD=Number(chosen.requestId)===Number(pm.collectionVariables.get('offer_d'));pm.collectionVariables.set('replacement_token',pm.collectionVariables.get(isD?'token_d':'token_e'));}"] } }],
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token_a}}" }], "url": "{{base_url}}/api/v1/chains/{{chain_id}}/replacements" }
        },
        { "name": "A pins first replacement", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token_a}}" }], "body": { "mode": "raw", "raw": "{\"requestId\":{{replacement_request_id}}}" }, "url": "{{base_url}}/api/v1/chains/{{chain_id}}/replacement" } },
        { "name": "A reconfirms first replacement", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token_a}}" }], "url": "{{base_url}}/api/v1/chains/{{chain_id}}/confirm" } },
        {
          "name": "First replacement confirms and freezes",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Replacement chain is FROZEN',()=>{pm.response.to.have.status(200);pm.expect(pm.response.json().status).to.eql('FROZEN');});"] } }],
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{replacement_token}}" }], "url": "{{base_url}}/api/v1/chains/{{chain_id}}/confirm" }
        },
        {
          "name": "Current replacement declines FROZEN",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Another replacement is possible',()=>{pm.response.to.have.status(200);pm.expect(pm.response.json().replacementAvailable).to.eql(true);});"] } }],
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{replacement_token}}" }], "url": "{{base_url}}/api/v1/chains/{{chain_id}}/decline" }
        },
        {
          "name": "C declines during replacement round",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Second refusal causes full rollback',()=>{pm.response.to.have.status(200);const b=pm.response.json();pm.expect(b.replacementAvailable).to.eql(false);pm.expect(b.status).to.eql('CANDIDATE');});"] } }],
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token_c}}" }], "url": "{{base_url}}/api/v1/chains/{{chain_id}}/decline" }
        },
        {
          "name": "A verifies rollback reason",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Chain rolled back visibly',()=>{pm.response.to.have.status(200);const b=pm.response.json();pm.expect(b.status).to.eql('CANDIDATE');pm.expect(b.invalidReason||b.invalid_reason).to.eql('participant_cancelled');});"] } }],
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token_a}}" }], "url": "{{base_url}}/api/v1/chains/{{chain_id}}" }
        }
      ]
    },
    {
      "name": "04 - Дедлайн (ручная подготовка БД)",
      "description": "Папка автоматически пропускается, пока не заданы expired_chain_id и expired_participant_token.",
      "item": [
        {
          "name": "Open expired frozen chain",
          "event": [{ "listen": "prerequest", "script": { "exec": ["if(!pm.collectionVariables.get('expired_chain_id')||!pm.collectionVariables.get('expired_participant_token')) pm.execution.skipRequest();"] } }, { "listen": "test", "script": { "exec": ["pm.test('Expired participant receives 410',()=>pm.response.to.have.status(410));"] } }],
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{expired_participant_token}}" }], "url": "{{base_url}}/api/v1/chains/{{expired_chain_id}}" }
        }
      ]
    }
  ]
}
