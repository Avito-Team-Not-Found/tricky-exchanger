# Пустой URL = relative /api/v1, идёт через Vite-proxy (vite.config.ts, server.proxy)
# на реальный Go-бэкенд :8080 — бэкенду не нужен CORS.
VITE_API_BASE_URL=

# Цепочки обмена (раздел «Варианты обмена») — на бэкенде пока не реализованы.
# Включить, когда появится Chains API.
VITE_FEATURE_CHAINS=false
