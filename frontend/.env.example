# Base URL of the backend API (the /api/v1 prefix is appended automatically).
# Пустой URL = relative /api/v1, в dev идёт через Vite-proxy (vite.config.ts) на реальный
# Go-бэкенд :8080 — бэкенду не нужен CORS. В проде предполагается общий reverse-proxy.
# Мок-сервер (`npm run mock`) — только инструмент локальной разработки без бэкенда и НЕ
# источник истины по контракту; для работы с ним укажите VITE_API_BASE_URL=http://localhost:4000
VITE_API_BASE_URL=

# Цепочки обмена (раздел «Варианты обмена») — на бэкенде пока не реализованы.
# Включить, когда появится Chains API.
VITE_FEATURE_CHAINS=false
