# YAML-конфиг выбран вместо .prettierrc.json: в JSON нельзя писать комментарии с обоснованием опций
# Точки с запятой — явный разделитель операторов, не полагаемся на ASI; так сложнее сломать код переносом строки
semi: true
# Одинарные кавычки — стиль по умолчанию, в них реже нужен экранирующий слэш, чем в двойных
singleQuote: true
# 100 символов — строка влезает в два столбца редактора без прокрутки и не дробит длинные выражения
printWidth: 100
# Запятая после последнего элемента — минимальный дифф при добавлении строк в массив или объект
trailingComma: all
# 2 пробела — компактнее четырёх при той же читаемости вложенности, стандарт для JS/TS
tabWidth: 2
# Скобки вокруг единственного аргумента стрелки — стабильный вид при появлении второго аргумента
arrowParens: always
