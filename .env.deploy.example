# Скопировать на VPS: /opt/menyayka/.env
# cp .env.deploy.example .env && nano .env
#
# Вместе с .env на сервере должны лежать:
#   docker-compose.prod.yml, Caddyfile, backend/migrations/
# Их копирует GitHub Actions; для ручного подъёма — rsync/scp.

# --- Postgres ---
DB_USER=menyayka
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DB_NAME=menyayka

# --- App ---
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING
LOG_LEVEL=info
# Пустой = same-origin /api через Caddy (как в проде).
VITE_API_BASE_URL=

# --- SMTP (mail.ru app password) ---
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_USERNAME=menyayka_avito@mail.ru
SMTP_PASSWORD=
SMTP_FROM=menyayka_avito@mail.ru
SMTP_ENCRYPTION=tls

# --- MinIO ---
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET
MINIO_BUCKET=items
# Публичные URL фото: https://menyayka.tech/s3/items/...
MINIO_PUBLIC_ENDPOINT=menyayka.tech/s3
MINIO_PUBLIC_USE_SSL=true

# --- Embeddings ---
EMBEDDING_PROVIDER=tei
VECTOR_DIM=384
TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.9

# --- Matching (можно оставить дефолты) ---
MATCHING_THRESHOLD=0.5
CLUSTER_SIMILARITY_THRESHOLD=0.9

# --- Images (перезаписываются CI при деплое) ---
DOCKER_IMAGE_PREFIX=ghcr.io/avito-team-not-found/tricky-exchanger
IMAGE_TAG=latest
